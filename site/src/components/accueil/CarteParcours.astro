---
// Le parcours, dessiné comme un plan de lignes (maquette accueil C, reprise de
// l'accueil A) : la Partie 0 en trait fin mène à la Partie 1, la ligne
// principale, plus épaisse ; ses cinq groupes sont nommés dans la marge de
// gauche. Les Parties 2 et 3 s'en détachent après 1.7 et 1.16.
//
// Chaque chapitre est un arrêt [data-chapitre-carte] : « à venir » s'il n'a pas
// encore de fichier, « disponible » sinon. Le script de l'accueil le passe à
// « fait » (tous les acquis gagnés) ou y montre les acquis déjà gagnés
// (« commencé », qui garde l'état disponible). Sur grand écran, il place les
// embranchements à droite, à la hauteur de leur départ ; sans lui, ils
// suivent la ligne principale.
import type { ChapitreParu } from '../../lib/chapitres-parus';
import {
  PARCOURS,
  chapitresDuGroupe,
  hrefChapitre,
  hrefPartie,
  titreCourt,
  trouverChapitre,
  type Chapitre,
} from '../../lib/parcours';
import { enLettres } from '../../lib/exemples';
import { typographier } from '../../lib/typo';

interface Props {
  parus: Map<string, ChapitreParu>;
}

const { parus } = Astro.props;
const [p0, p1, ...branches] = PARCOURS;
const total = PARCOURS.reduce((n, p) => n + p.chapitres.length, 0);
const departs = new Set(branches.map((b) => b.depart));
const nbParus = parus.size;
// « Quatre parties, 34 chapitres. » : les deux nombres viennent du parcours.
const nbParties = enLettres(PARCOURS.length);
const enTete = `${nbParties.charAt(0).toUpperCase()}${nbParties.slice(1)} parties, ${total} chapitres.`;
---

<section class="parcours" id="parcours" aria-labelledby="t-parcours">
  <div class="parcours-tete">
    <h2 id="t-parcours">Le parcours</h2>
    <p>
      {
        typographier(
          `${enTete} La ligne principale, la Partie 1, fabrique une seule IA, « ton IA », de chapitre en chapitre. Les chapitres paraissent au fur et à mesure.`,
        )
      }
    </p>
    <div class="releve">
      <span class="barres" aria-hidden="true">
        {
          PARCOURS.map((partie) => (
            <span>
              {partie.chapitres.map((c) => (
                <i class:list={{ dispo: parus.has(c.numero) }} data-barre={c.numero} />
              ))}
            </span>
          ))
        }
      </span>
      <span data-compte-faits>
        <strong>0 sur {total}</strong>
        {typographier(` chapitres faits, ${nbParus} paru${nbParus > 1 ? 's' : ''} pour l'instant`)}
      </span>
    </div>
    <ul class="cles" aria-label="Légende du plan">
      <li><span class="arret arret-cle cle-disponible"></span>disponible</li>
      <li><span class="arret arret-cle cle-fait"></span>fait</li>
      <li><span class="arret arret-cle cle-a-venir"></span>à venir</li>
    </ul>
  </div>

  <div class="carte" data-carte>
    {
      [p0, p1, ...branches].map((partie) => {
        const branche = partie.depart !== undefined;
        // Un arrêt du plan.
        const station = (c: Chapitre, terminus: boolean) => {
          const paru = parus.get(c.numero);
          return (
            <li
              class:list={['station', { terminus, depart: departs.has(c.numero) }]}
              data-chapitre-carte={c.numero}
              data-etat={paru ? 'disponible' : 'a-venir'}
              data-acquis={paru?.acquis.join(' ')}
              data-titre-court={paru ? typographier(titreCourt(c.titre)) : undefined}
            >
              <span class="arret" aria-hidden="true" />
              {paru ? (
                <a class="st" href={hrefChapitre(c.numero)}>
                  <span class="num">{c.numero}</span>
                  <span class="titre">{typographier(c.titre)}</span>
                </a>
              ) : (
                <span class="st">
                  <span class="num">{c.numero}</span>
                  <span class="titre">{typographier(c.titre)}</span>
                  <span class="vh">, à venir</span>
                </span>
              )}
              {paru && (
                <span class="infos" data-infos>
                  {typographier(`disponible, ${paru.programme}`)}
                </span>
              )}
              {c.jalon && <span class="jalon">{typographier(c.jalon)}</span>}
            </li>
          );
        };
        const liste = (chapitres: Chapitre[], dernier: boolean) => (
          <ol class="corps stations">
            {chapitres.map((c, i) => station(c, dernier && i === chapitres.length - 1))}
          </ol>
        );
        return (
          <>
            <section
              class:list={['ligne', `l${partie.numero}`, { branche }]}
              aria-labelledby={`l${partie.numero}`}
              data-depart={partie.depart}
              data-ligne={partie.numero}
            >
              <div class="troncon tete-ligne">
                <span class="pastille" aria-hidden="true">
                  {partie.numero}
                </span>
                <div class="corps">
                  <h3 id={`l${partie.numero}`}>
                    <a href={hrefPartie(partie.numero)}>
                      <span class="vh">Partie {partie.numero}, </span>
                      {typographier(partie.titre)}
                    </a>
                  </h3>
                  <p>{typographier(partie.resume)}</p>
                  {partie.numero === 1 && <p class="vh">{typographier("C'est la partie principale du site.")}</p>}
                  {partie.depart && (
                    <p class="depuis">
                      {typographier(
                        `Elle part de la Partie 1 après ${partie.depart}, ${trouverChapitre(partie.depart).chapitre.titre}.`,
                      )}
                    </p>
                  )}
                </div>
              </div>
              {partie.groupes ? (
                partie.groupes.map((groupe, i) => {
                  const chapitres = chapitresDuGroupe(partie, groupe);
                  return (
                    <div class="troncon">
                      <div class="gout">
                        <h4>{typographier(groupe.nom)}</h4>
                        <span class="plage">
                          {chapitres[0].numero} à {chapitres[chapitres.length - 1].numero}
                        </span>
                        <p>{typographier(groupe.resume)}</p>
                      </div>
                      {liste(chapitres, i === partie.groupes!.length - 1)}
                    </div>
                  );
                })
              ) : (
                <div class="troncon">{liste(partie.chapitres, branche)}</div>
              )}
            </section>
            {branche && <div class="raccord" aria-hidden="true" data-raccord={partie.numero} />}
          </>
        );
      })
    }
  </div>
</section>

<style>
  .parcours {
    max-width: 1180px;
    margin: 0 auto;
    padding: 104px 24px 0;
  }

  .parcours-tete {
    margin-bottom: 44px;
  }

  .parcours-tete h2 {
    font-weight: 800;
    font-size: 44px;
    letter-spacing: -0.02em;
    margin-bottom: 10px;
  }

  /* 31 em : moins de 80 signes par ligne. */
  .parcours-tete p {
    max-width: 31em;
    font-size: 19px;
    margin-bottom: 18px;
  }

  /* Le relevé : un trait par chapitre, et le compte des chapitres faits. */
  .releve {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 20px;
    font-family: var(--titres);
    font-size: 16px;
    color: var(--indigo-doux);
  }

  .releve strong {
    color: var(--indigo);
    font-weight: 700;
  }

  .barres {
    display: flex;
    gap: 7px;
  }

  .barres > span {
    display: flex;
    gap: 2px;
  }

  .barres i {
    width: 7px;
    height: 16px;
    border-radius: 2px;
    background: var(--brume);
  }

  .barres i.dispo {
    background: var(--indigo);
  }

  .barres i.fait {
    background: var(--menthe);
  }

  /* La légende. */
  .cles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    font-family: var(--titres);
    font-size: 15px;
    color: var(--indigo-doux);
  }

  .cles li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .cles .arret-cle {
    position: static;
    display: inline-block;
    flex: none;
  }

  .cles .cle-disponible {
    --d: 20px;
    border: 5px solid var(--indigo);
    background: var(--indigo);
    box-shadow: inset 0 0 0 3px var(--papier);
  }

  .cles .cle-fait {
    --d: 20px;
    border: 0;
    background: var(--menthe);
  }

  .cles .cle-a-venir {
    --d: 16px;
    border: 4px solid var(--indigo);
  }

  /* ---------- Le plan ---------- */
  .carte {
    --gout: 230px;
    --rail-x: 22px;
    --col-num: 58px;
    position: relative;
  }

  .ligne {
    --ligne: var(--indigo-doux);
    --ep: 6px;
    position: relative;
    overflow-y: clip;
  }

  .l1 {
    --ligne: var(--indigo);
    --ep: 12px;
  }

  .troncon {
    position: relative;
    display: grid;
    grid-template-columns: var(--gout) minmax(0, 1fr);
  }

  /* Le trait de la ligne. */
  .troncon::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 1;
    left: calc(var(--gout) + var(--rail-x) - var(--ep) / 2);
    width: var(--ep);
    background: var(--ligne);
  }

  .gout {
    grid-column: 1;
    padding: 10px 40px 24px 0;
  }

  .corps {
    grid-column: 2;
    padding-left: 60px;
    min-width: 0;
  }

  /* Tête de ligne : la pastille de la partie, posée sur la ligne. */
  .tete-ligne .corps {
    padding-top: 8px;
    padding-bottom: 26px;
  }

  .pastille {
    position: absolute;
    z-index: 3;
    top: 8px;
    left: calc(var(--gout) + var(--rail-x) - 24px);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: var(--titres);
    font-weight: 800;
    font-size: 24px;
    line-height: 1;
    background: var(--papier);
    color: var(--indigo-doux);
    border: 5px solid var(--ligne);
  }

  .l1 .pastille {
    width: 60px;
    height: 60px;
    top: 4px;
    left: calc(var(--gout) + var(--rail-x) - 30px);
    font-size: 30px;
    background: var(--indigo);
    color: var(--papier);
    border-color: var(--indigo);
  }

  .tete-ligne::before {
    top: 32px;
  }

  /* La Partie 0 arrive dans la pastille de la Partie 1. */
  .l1 .tete-ligne::after {
    content: '';
    position: absolute;
    top: 0;
    height: 34px;
    z-index: 0;
    left: calc(var(--gout) + var(--rail-x) - 3px);
    width: 6px;
    background: var(--indigo-doux);
  }

  .tete-ligne h3 {
    font-weight: 800;
    font-size: 30px;
    letter-spacing: -0.015em;
    padding-top: 8px;
    margin-bottom: 6px;
  }

  .tete-ligne h3 a {
    text-decoration: none;
  }

  .tete-ligne h3 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 0.15em;
  }

  .l1 .tete-ligne h3 {
    font-size: 46px;
    letter-spacing: -0.025em;
    padding-top: 4px;
    margin-bottom: 12px;
  }

  .tete-ligne p {
    font-size: 18px;
    line-height: 1.5;
    color: var(--indigo-doux);
    max-width: 31em;
    margin: 0;
  }

  .l1 .tete-ligne p {
    font-size: 20px;
    color: var(--indigo);
  }

  /* Les groupes de la Partie 1 : leur nom dans la marge, à gauche de la ligne. */
  .gout h4 {
    font-weight: 700;
    font-size: 20px;
    line-height: 1.25;
    margin-bottom: 2px;
  }

  .gout .plage {
    display: block;
    font-family: var(--titres);
    font-weight: 500;
    font-size: 15px;
    color: var(--indigo-doux);
    margin-bottom: 8px;
  }

  .gout p {
    font-size: 16px;
    line-height: 1.45;
    color: var(--indigo-doux);
    margin: 0;
  }

  /* Les arrêts. */
  .stations {
    list-style: none;
    margin: 0;
    padding-top: 6px;
    padding-bottom: 24px;
  }

  .station {
    position: relative;
    padding: 7px 0;
    font-size: 19px;
    line-height: 1.4;
  }

  .st {
    display: grid;
    grid-template-columns: var(--col-num) minmax(0, 1fr);
    text-decoration: none;
  }

  .st .num {
    font-family: var(--titres);
    font-weight: 700;
    font-size: 18px;
    font-variant-numeric: tabular-nums;
    color: var(--indigo-doux);
    padding-top: 1px;
  }

  .st .titre {
    color: var(--indigo-doux);
  }

  .arret {
    --d: 18px;
    position: absolute;
    z-index: 2;
    left: calc(var(--rail-x) - 60px - var(--d) / 2);
    top: calc(7px + 0.7em - var(--d) / 2);
    width: var(--d);
    height: var(--d);
    border-radius: 50%;
    background: var(--papier);
    border: 4px solid var(--ligne);
  }

  .l1 .arret {
    --d: 22px;
    border-width: 5px;
  }

  .station[data-etat='disponible'] .arret,
  .station[data-etat='fait'] .arret {
    --d: 30px;
    top: calc(12px + 0.7em - var(--d) / 2);
  }

  .station[data-etat='disponible'] .arret {
    background: var(--indigo);
    border: 6px solid var(--indigo);
    box-shadow: inset 0 0 0 4px var(--papier);
  }

  .station[data-etat='fait'] .arret {
    background: var(--menthe);
    border: 0;
    box-shadow: 0 0 0 4px var(--papier);
  }

  .station[data-etat='fait'] .arret::after {
    content: '\2713';
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--titres);
    font-weight: 800;
    font-size: 17px;
    color: var(--papier);
  }

  .station[data-etat='disponible'],
  .station[data-etat='fait'] {
    padding: 12px 0 14px;
  }

  .station[data-etat='disponible'] .st .num,
  .station[data-etat='fait'] .st .num,
  .station[data-etat='disponible'] .st .titre,
  .station[data-etat='fait'] .st .titre {
    color: var(--indigo);
  }

  a.st .titre {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--lavande);
    text-underline-offset: 0.22em;
  }

  a.st:hover .titre {
    text-decoration-color: var(--indigo);
  }

  .infos {
    display: block;
    margin: 4px 0 0 var(--col-num);
    font-family: var(--titres);
    font-size: 15px;
    line-height: 1.4;
    color: var(--indigo-doux);
  }

  /* Pastilles et mention « fait », posées par le script. */
  .infos :global(.pips) {
    display: inline-flex;
    gap: 4px;
    margin-right: 8px;
    vertical-align: -1px;
  }

  .infos :global(.pips i) {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid var(--lavande);
  }

  .infos :global(.pips i.plein) {
    background: var(--menthe);
    border-color: var(--menthe);
  }

  .infos :global(.fait-txt) {
    color: var(--menthe);
    font-weight: 700;
  }

  .jalon {
    display: block;
    margin: 1px 0 0 var(--col-num);
    font-style: italic;
    font-size: 17px;
    color: var(--indigo);
  }

  /* Terminus : la ligne s'arrête au dernier arrêt. */
  .terminus::after {
    content: '';
    position: absolute;
    z-index: 1;
    left: calc(var(--rail-x) - 60px - var(--ep) / 2 - 1px);
    width: calc(var(--ep) + 2px);
    top: calc(7px + 0.7em);
    bottom: -400px;
    background: var(--papier);
  }

  .stations:has(.terminus) {
    padding-bottom: 8px;
  }

  /* Les embranchements : à droite du plan sur grand écran, à la suite sinon. */
  .branche {
    margin-top: 30px;
  }

  .branche .gout {
    display: none;
  }

  .raccord {
    display: none;
  }

  .tete-ligne .depuis {
    font-family: var(--titres);
    margin-top: 4px;
  }

  @media (min-width: 1220px) {
    .carte.placee {
      padding-right: 400px;
    }

    .carte.placee .branche {
      position: absolute;
      right: 0;
      width: 380px;
      margin: 0;
      --gout: 0px;
    }

    .carte.placee .branche .troncon {
      grid-template-columns: 0 minmax(0, 1fr);
    }

    /* Masquée à l'écran seulement (même motif que .vh) : le raccord dessine
       le départ, mais les lecteurs d'écran ont toujours la phrase. */
    .carte.placee .depuis {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
      border: 0;
    }

    .carte.placee .station.depart {
      margin-bottom: 34px;
    }

    .carte.placee .raccord {
      display: block;
      position: absolute;
      z-index: 0;
      border-left: 6px solid var(--indigo-doux);
      border-bottom: 6px solid var(--indigo-doux);
      border-bottom-left-radius: 26px;
    }
  }

  @media (max-width: 1000px) {
    .carte {
      --gout: 0px;
    }

    .troncon {
      grid-template-columns: minmax(0, 1fr);
    }

    .gout {
      grid-column: 1;
      text-align: left;
      padding: 20px 0 2px 60px;
    }

    .gout p {
      max-width: 30em;
    }

    .corps {
      grid-column: 1;
    }
  }

  @media (max-width: 720px) {
    .parcours {
      padding: 72px 20px 0;
    }

    .parcours-tete h2 {
      font-size: 34px;
    }

    .parcours-tete p {
      font-size: 18px;
    }

    .carte {
      --rail-x: 16px;
      --col-num: 50px;
    }

    .corps,
    .gout {
      padding-left: 46px;
    }

    .arret {
      left: calc(var(--rail-x) - 46px - var(--d) / 2);
    }

    .terminus::after {
      left: calc(var(--rail-x) - 46px - var(--ep) / 2 - 1px);
    }

    .pastille {
      width: 40px;
      height: 40px;
      font-size: 20px;
      left: calc(var(--rail-x) - 20px);
    }

    .l1 .pastille {
      width: 48px;
      height: 48px;
      font-size: 24px;
      left: calc(var(--rail-x) - 24px);
    }

    .tete-ligne::before {
      top: 28px;
    }

    .tete-ligne h3 {
      font-size: 25px;
    }

    .l1 .tete-ligne h3 {
      font-size: 32px;
    }

    .l1 .tete-ligne p {
      font-size: 18px;
    }

    .station {
      font-size: 17px;
    }

    .st .num {
      font-size: 16px;
    }
  }
</style>
