---
// L'ouverture du chapitre 1.2 : ce que lit ton IA, en une seule bande. Les
// trois sources se partagent sa largeur selon leur part du mélange de forge
// (MELANGE, donnees.ts, vérifié contre melange.py). Sous la bande, chaque
// source est nommée, avec sa part, à la taille du texte, au bout d'un trait
// qui descend de son morceau de bande, en escalier : un renvoi par ligne,
// à gauche du trait pour les morceaux de la moitié droite, à droite sinon.
// Tout est rendu à la construction : la page arrive prête, sans script.
//
// La bande et les traits sont cachés aux lecteurs d'écran : la liste des
// renvois dit les mêmes parts, en mots.
import { pourcent } from '../../../lib/nombres';
import { MELANGE, NOMS_DES_SOURCES } from '../../../lib/partie-1/donnees';
import { typographier } from '../../../lib/typo';

/** Le nom de chaque source, tel que le renvoi le dit. */
const NOMS = {
  web_fr: 'pages web en français',
  wikipedia_fr: 'Wikipédia en français',
  code_python: 'code Python',
} as const;

// Le trait d'un morceau de la moitié gauche part près de son début (au plus
// 15 % de la bande plus loin) ; celui d'un morceau de la moitié droite, de
// son milieu. Les renvois ne se croisent pas : chacun a sa ligne.
let debut = 0;
const renvois = NOMS_DES_SOURCES.map((source, rang) => {
  const part = MELANGE[source];
  const aDroite = debut > 0.5;
  const ancre = aDroite ? debut + part / 2 : debut + Math.min(part / 2, 0.15);
  debut += part;
  return { source, part, rang, aDroite, ancre: `${(ancre * 100).toFixed(2)}%`, texte: typographier(`${NOMS[source]}, ${pourcent(part)}`) };
});
const legende = typographier(
  'La part de chaque source dans les textes de ton IA, comptée en octets. Ce mélange est écrit dans forge, ' +
    'son moteur ; ce chapitre dit où l’on trouve ces textes, ce qu’on a le droit d’en faire, et comment ' +
    'on les prépare.',
);
---

<figure class="ouverture-melange" data-test="ouverture">
  <div class="bande" aria-hidden="true">
    {renvois.map((r) => <span class:list={['part', r.source]} style={`flex-grow: ${r.part}`} />)}
  </div>
  <ol class="renvois">
    {
      renvois.map((r) => (
        <li data-source={r.source} class:list={{ 'a-droite': r.aDroite }} style={`--ancre: ${r.ancre}; --rang: ${r.rang}`}>
          <span class="trait" aria-hidden="true" />
          {r.texte}
        </li>
      ))
    }
  </ol>
  <figcaption>{legende}</figcaption>
</figure>

<style>
  .ouverture-melange {
    margin: 0 0 2.2em;
    --ligne: 1.7em;
    --ecart: 12px;
  }

  /* Une seule bande, partagée à plat : pas de dégradé, pas d'ombre. */
  .bande {
    display: flex;
    gap: 3px;
    height: 34px;
  }

  .part {
    flex-basis: 0;
    border-radius: 3px;
  }

  .web_fr {
    background: var(--indigo);
  }

  .wikipedia_fr {
    background: var(--lavande);
  }

  .code_python {
    background: var(--teinte-b-trait);
  }

  /* Les renvois : un par ligne, en escalier, chacun au bout de son trait. */
  .renvois {
    list-style: none;
    padding: 0;
    margin: var(--ecart) 0 0;
  }

  .renvois li {
    position: relative;
    height: var(--ligne);
    line-height: var(--ligne);
    white-space: nowrap;
    padding-left: calc(var(--ancre) + 10px);
  }

  .renvois li.a-droite {
    padding-left: 0;
    padding-right: calc(100% - var(--ancre) + 10px);
    text-align: right;
  }

  /* Le trait descend du bas de la bande jusqu'au milieu de la ligne de son renvoi. */
  .trait {
    position: absolute;
    left: var(--ancre);
    top: calc(-1 * (var(--rang) * var(--ligne) + var(--ecart)));
    height: calc(var(--rang) * var(--ligne) + var(--ecart) + var(--ligne) / 2);
    width: 1px;
    background: var(--indigo-doux);
  }

  figcaption {
    margin-top: 14px;
    color: var(--indigo-doux);
  }

  @media (max-width: 720px) {
    .bande {
      height: 26px;
    }
  }
</style>
