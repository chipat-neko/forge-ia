---
// Le plan d'ensemble du chapitre 1.4 : le transformer de ton IA dans sa plus
// grande taille (« très grand »), dessiné à la main, de haut en bas. Un trait
// épais porte le vecteur de chaque jeton, du plongement à la norme finale ;
// dans chaque bloc, deux détours en partent (RMSNorm puis attention, RMSNorm
// puis MLP) et reviennent s'y ajouter (⊕) : c'est le `x +` des blocs. Un
// pointillé relie le plongement aux logits : la même table (poids liés).
//
// Tous les nombres viennent de PRESETS_FORGE.tres_grand et de largeurCachee
// (calculateur/ton-ia.ts, jumeaux de forge) : rien n'est tapé.
//
// Accessible : le dessin a un titre (son nom) et une description, et une liste
// en texte, réservée aux lecteurs d'écran, dit la même chose étage par étage.
// Tout est rendu à la construction : la page arrive prête, sans script.
import { largeurCachee, PRESETS_FORGE } from '../../../lib/calculateur/ton-ia';
import { nombre } from '../../../lib/nombres';
import { typographier } from '../../../lib/typo';

const f = PRESETS_FORGE.tres_grand;
const dimTete = f.dim / f.tetes;
const cachee = largeurCachee(f.dim);
const n = {
  couches: nombre(f.couches),
  dim: nombre(f.dim),
  tetes: nombre(f.tetes),
  dimTete: nombre(dimTete),
  vocabulaire: nombre(f.vocabulaire),
  contexte: nombre(f.contexte),
  cachee: nombre(cachee),
};

const titre = typographier(`Le transformer de ton IA, en taille « très grand »`);
const description = typographier(
  `De haut en bas : les jetons, le plongement, ${n.couches} blocs d’attention et de MLP, ` +
    'une dernière RMSNorm, puis les logits. La liste qui suit le décrit étage par étage.',
);
const etages = [
  `Les jetons du texte, jusqu’à ${n.contexte} à la fois.`,
  `Le plongement : chaque jeton devient un vecteur de ${n.dim} nombres, sa ligne dans une table de ${n.vocabulaire} lignes.`,
  `${n.couches} blocs, l’un après l’autre. Dans chacun, une RMSNorm, puis l’attention, à ${n.tetes} têtes de ${n.dimTete} nombres, ` +
    `dont le résultat s’ajoute au vecteur ; puis une RMSNorm, puis le MLP SwiGLU, qui passe par ${n.cachee} nombres, ` +
    'et dont le résultat s’ajoute aussi au vecteur.',
  'Une dernière RMSNorm.',
  `Les logits : un score pour chacun des ${n.vocabulaire} jetons possibles, calculé avec la table du plongement.`,
].map(typographier);
const legende = typographier(
  'Ton IA dans sa plus grande taille, lue de haut en bas. Le trait épais porte le vecteur de chaque jeton ; ' +
    'chaque détour passe par une pièce, puis revient s’y ajouter (⊕). Le pointillé relie deux usages de la même table.',
);
// Les textes du dessin : courts, ils tiennent dans leurs cases à 390 px.
const t = {
  jetons: typographier(`jusqu’à ${n.contexte} jetons`),
  plongement: typographier(`une ligne de ${n.dim} nombres par jeton`),
  tetes: typographier(`${n.tetes} têtes de ${n.dimTete} nombres`),
  mlp: `${n.dim} → ${n.cachee} → ${n.dim}`,
  logits: typographier(`un score pour chacun des ${n.vocabulaire} jetons,`),
  logits2: 'avec la table du plongement',
  fois: `× ${n.couches}`,
};
---

<figure class="schema-transformer" data-test="schema">
  <svg viewBox="0 0 364 474" role="img" aria-labelledby="schema-titre" aria-describedby="schema-desc">
    <title id="schema-titre">{titre}</title>
    <desc id="schema-desc">{description}</desc>

    <!-- Les jetons : des morceaux teintés, comme ceux du chapitre 1.3. -->
    <rect class="jeton a" x="40" y="8" width="22" height="20" rx="4"></rect>
    <rect class="jeton b" x="66" y="8" width="22" height="20" rx="4"></rect>
    <rect class="jeton a" x="92" y="8" width="22" height="20" rx="4"></rect>
    <rect class="jeton b" x="118" y="8" width="22" height="20" rx="4"></rect>
    <text class="petit" x="152" y="23">{t.jetons}</text>
    <line class="trait" x1="80" y1="28" x2="80" y2="42"></line>
    <polygon class="pointe" points="80,48 75,40 85,40"></polygon>

    <!-- Le plongement. -->
    <rect class="case chaude" x="40" y="50" width="300" height="46" rx="2"></rect>
    <text class="nom" x="54" y="69">plongement</text>
    <text class="petit" x="54" y="87">{t.plongement}</text>

    <!-- Le trait du vecteur, du plongement à la norme finale. -->
    <line class="axe" x1="80" y1="96" x2="80" y2="360"></line>

    <!-- Les blocs : un crochet, et « × 20 ». -->
    <polyline class="crochet" points="64,112 58,112 58,340 64,340"></polyline>
    <text class="fois" x="50" y="230">{t.fois}</text>
    <text class="petit fin" x="50" y="248">blocs</text>

    <!-- Le détour de l'attention. -->
    <line class="detour" x1="80" y1="130" x2="150" y2="130"></line>
    <rect class="case norme" x="150" y="118" width="190" height="24" rx="2"></rect>
    <text class="petit" x="160" y="135">RMSNorm</text>
    <line class="detour" x1="245" y1="142" x2="245" y2="154"></line>
    <rect class="case froide" x="150" y="154" width="190" height="44" rx="2"></rect>
    <text class="nom" x="160" y="172">attention</text>
    <text class="petit" x="160" y="189">{t.tetes}</text>
    <polyline class="detour" points="245,198 245,216 92,216"></polyline>
    <polygon class="pointe-douce" points="89,216 97,212 97,220"></polygon>
    <circle class="plus" cx="80" cy="216" r="9"></circle>
    <line class="plus-trait" x1="75" y1="216" x2="85" y2="216"></line>
    <line class="plus-trait" x1="80" y1="211" x2="80" y2="221"></line>

    <!-- Le détour du MLP. -->
    <line class="detour" x1="80" y1="242" x2="150" y2="242"></line>
    <rect class="case norme" x="150" y="230" width="190" height="24" rx="2"></rect>
    <text class="petit" x="160" y="247">RMSNorm</text>
    <line class="detour" x1="245" y1="254" x2="245" y2="266"></line>
    <rect class="case froide" x="150" y="266" width="190" height="44" rx="2"></rect>
    <text class="nom" x="160" y="284">MLP SwiGLU</text>
    <text class="petit" x="160" y="301">{t.mlp}</text>
    <polyline class="detour" points="245,310 245,328 92,328"></polyline>
    <polygon class="pointe-douce" points="89,328 97,324 97,332"></polygon>
    <circle class="plus" cx="80" cy="328" r="9"></circle>
    <line class="plus-trait" x1="75" y1="328" x2="85" y2="328"></line>
    <line class="plus-trait" x1="80" y1="323" x2="80" y2="333"></line>

    <!-- La norme finale, puis les logits. -->
    <rect class="case norme" x="40" y="360" width="300" height="28" rx="2"></rect>
    <text class="petit" x="54" y="379">RMSNorm finale</text>
    <line class="trait" x1="80" y1="388" x2="80" y2="400"></line>
    <polygon class="pointe" points="80,406 75,398 85,398"></polygon>
    <rect class="case chaude" x="40" y="408" width="300" height="60" rx="2"></rect>
    <text class="nom" x="54" y="427">logits</text>
    <text class="petit" x="54" y="445">{t.logits}</text>
    <text class="petit" x="54" y="461">{t.logits2}</text>

    <!-- Les poids liés : la même table au début et à la fin. -->
    <polyline class="lie" points="340,73 354,73 354,438 340,438"></polyline>
  </svg>
  <ol class="vh" data-test="schema-liste">
    {etages.map((e) => <li>{e}</li>)}
  </ol>
  <figcaption>{legende}</figcaption>
</figure>

<style>
  .schema-transformer {
    margin: 0.4em 0 1.6em;
  }

  svg {
    display: block;
    width: 100%;
    max-width: 440px;
    height: auto;
  }

  text {
    fill: var(--indigo);
    font-family: var(--titres);
  }

  .nom {
    font-weight: 700;
    font-size: 16px;
  }

  .petit {
    font-size: 13.5px;
  }

  .fin {
    text-anchor: end;
    fill: var(--indigo-doux);
  }

  .fois {
    font-weight: 800;
    font-size: 24px;
    text-anchor: end;
    letter-spacing: -0.02em;
  }

  .jeton.a {
    fill: var(--teinte-a);
    stroke: var(--teinte-a-trait);
  }

  .jeton.b {
    fill: var(--teinte-b);
    stroke: var(--teinte-b-trait);
  }

  /* Des cases à plat, sans ombre ni dégradé : chaudes pour la table des jetons, froides pour les pièces qui calculent. */
  .case {
    stroke: var(--indigo);
    stroke-width: 1.25;
  }

  .chaude {
    fill: var(--teinte-b);
  }

  .froide {
    fill: var(--teinte-a);
  }

  .norme {
    fill: var(--brume-claire);
    stroke: var(--lavande);
  }

  /* Le vecteur de chaque jeton : le trait épais. */
  .axe {
    stroke: var(--indigo);
    stroke-width: 3.5;
  }

  .trait {
    stroke: var(--indigo);
    stroke-width: 2;
  }

  .pointe {
    fill: var(--indigo);
  }

  .detour {
    fill: none;
    stroke: var(--indigo-doux);
    stroke-width: 1.5;
  }

  .pointe-douce {
    fill: var(--indigo-doux);
  }

  .plus {
    fill: var(--papier);
    stroke: var(--indigo);
    stroke-width: 2;
  }

  .plus-trait {
    stroke: var(--indigo);
    stroke-width: 2;
  }

  .crochet {
    fill: none;
    stroke: var(--indigo);
    stroke-width: 1.5;
  }

  .lie {
    fill: none;
    stroke: var(--lavande);
    stroke-width: 1.5;
    stroke-dasharray: 5 4;
  }

  figcaption {
    margin-top: 10px;
    color: var(--indigo-doux);
  }
</style>
