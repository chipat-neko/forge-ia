---
// Les jetons que ton IA, la vraie, juge les plus probables après une phrase (chapitre 1.1, « Ton IA
// prédit la suite ») : ceux de projets/1.6-evaluation/sorties/ton-ia-suivants.json, lus par le
// chapitre (lireSuivants, dans evaluation.ts) et passés ici, tels quels. Une ligne par jeton : le
// jeton, avec son espace de tête écrite « ␣ », une barre (sa chance rapportée à celle du premier) et
// sa chance ; en pied, la part des jetons du tableau, ensemble. Les chances sont celles du fichier :
// rien n'est recalculé, seulement additionné pour le pied.
//
// Un tableau typographié, avec les barres de l'atelier du chapitre (AtelierModeleDeLangage). Les
// jetons sont des données brutes : la recherche les ignore (data-pagefind-ignore).
//
//   <SuivantsTonIA suivants={SUIVANTS} />
import { formaterDate } from '../../../lib/calculateur/formats';
import { nombre, pourcent } from '../../../lib/nombres';
import type { FichierSuivants } from '../../../lib/partie-1/evaluation';
import { typographier } from '../../../lib/typo';

interface Props {
  /** Le fichier des jetons suivants (sorties/ton-ia-suivants.json), lu et vérifié par le chapitre. */
  suivants: FichierSuivants;
}

const { suivants } = Astro.props;
const premier = suivants.suivants[0].probabilite;
let total = 0;
for (const s of suivants.suivants) total += s.probabilite;
const lignes = suivants.suivants.map((s) => ({
  jeton: s.jeton,
  visible: s.jeton.replace(/ /g, '␣').replace(/\n/g, '↵'),
  chance: pourcent(s.probabilite, 1),
  largeur: `--largeur: ${((100 * s.probabilite) / premier).toFixed(1)}%`,
}));
const n = nombre(suivants.suivants.length);
const avant = typographier(
  `Les ${n} jetons que ${suivants.nom} juge les plus probables après « ${suivants.phrase} », du plus probable au moins probable. ` +
    'Calculés sur le processeur par la commande ',
);
const apres = typographier(` du projet 1.6, depuis les poids publiés de ${suivants.nom}, le ${formaterDate(suivants.releve_le)}. Le signe `);
const idLegende = 'suivants-ton-ia';
---

<figure class="suivants-ton-ia" data-suivants-ton-ia>
  <figcaption id={idLegende}>
    {avant}<code>suivants</code>{apres}<code class="signe">␣</code>{typographier(' marque l’espace qui fait partie du jeton.')}
  </figcaption>
  <table aria-labelledby={idLegende}>
    <thead>
      <tr>
        <th scope="col">Jeton</th>
        <th scope="col"><span class="vh">Sa chance, en barre</span></th>
        <th scope="col" class="nombre">Chance</th>
      </tr>
    </thead>
    <tbody>
      {
        lignes.map((l) => (
          <tr>
            <th scope="row">
              <span class="jeton" data-jeton={l.jeton} data-pagefind-ignore>
                {l.visible}
              </span>
            </th>
            <td class="piste">
              <span class="barre" style={l.largeur} />
            </td>
            <td class="nombre" data-test="suivant-chance">
              {l.chance}
            </td>
          </tr>
        ))
      }
    </tbody>
    <tfoot>
      <tr>
        <th scope="row" colspan="2">{typographier(`Les ${n} ensemble`)}</th>
        <td class="nombre">{pourcent(total, 1)}</td>
      </tr>
    </tfoot>
  </table>
</figure>

<style>
  .suivants-ton-ia {
    margin: 1.1em 0 1.2em;
  }

  figcaption {
    margin-bottom: 8px;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  thead th {
    font-family: var(--titres);
    font-weight: 600;
    font-size: 15px;
    line-height: 1.3;
    color: var(--indigo-doux);
    text-align: left;
    vertical-align: bottom;
    padding: 0 14px 6px 0;
    border-bottom: 2px solid var(--indigo);
  }

  tbody th,
  td {
    padding: 4px 14px 4px 0;
    border-bottom: 1px solid var(--brume);
    vertical-align: middle;
  }

  tbody th {
    font-weight: 400;
    text-align: left;
    white-space: nowrap;
  }

  th:last-child,
  td:last-child {
    padding-right: 0;
  }

  /* Le jeton tel que ton IA le lit, en teinte, comme les morceaux du chapitre 1.3. */
  .jeton {
    display: inline-block;
    padding: 0 6px;
    background: var(--teinte-a);
    border-radius: 4px;
    font-family: var(--mono);
    font-size: 16px;
    line-height: 1.6;
    white-space: pre;
  }

  tbody tr:nth-child(even) .jeton {
    background: var(--teinte-b);
  }

  td.piste {
    width: 100%;
  }

  .barre {
    display: block;
    width: var(--largeur);
    height: 10px;
    min-width: 1px;
    background: var(--indigo-doux);
    border-radius: 2px;
  }

  .nombre {
    text-align: right;
    font-family: var(--titres);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  tfoot th {
    text-align: left;
  }

  .signe {
    font-variant-ligatures: none;
  }

  tfoot th,
  tfoot td {
    border-bottom: 0;
    border-top: 2px solid var(--indigo);
    font-family: var(--titres);
    font-weight: 600;
    font-size: 15px;
    color: var(--indigo-doux);
  }
</style>
