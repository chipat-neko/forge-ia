---
// Barre du haut, collée en haut de l'écran et opaque : nom du site, position
// dans le parcours, barre des étapes du chapitre et pastilles des acquis.
// Les liens des étapes sont posés par le script du chapitre, qui lit les
// étapes de la page (elles viennent du contenu MDX).
import { trouverChapitre } from '../../lib/parcours';

interface Props {
  numero: string;
  acquis: { cle: string }[];
}

const { numero, acquis } = Astro.props;
const { partie, total } = trouverChapitre(numero);
const accueil = import.meta.env.BASE_URL;
---

<header class="barre">
  <div class="barre-in">
    <a class="marque" href={accueil}>La Forge IA</a>
    {/* Sur téléphone, seule la forme courte « 1.3 sur 21 » se voit ; le début
        reste lu par les lecteurs d'écran (voir .ou-debut plus bas). */}
    <span class="ou"><span class="ou-debut">Partie {partie.numero}, chapitre</span> {numero} sur {total}</span>
    <nav class="etapes-barre" aria-label="Étapes du chapitre" data-barre-etapes></nav>
    <a class="acquis-mini" href="#recap" data-acquis-mini aria-label={`Ce que tu sais\u202F: 0 sur ${acquis.length}`}>
      <span>Ce que tu sais</span>
      <span class="pips" aria-hidden="true">{acquis.map(() => <i />)}</span>
    </a>
  </div>
</header>

<style is:global>
  /* Opaque : le texte ne doit pas se voir à travers quand on défile. */
  .barre {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--papier);
    border-bottom: 1px solid var(--brume);
  }

  .barre-in {
    max-width: 1108px;
    margin: 0 auto;
    padding: 12px 24px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 28px;
    font-family: var(--titres);
    line-height: 1.3;
  }

  .marque {
    font-weight: 800;
    font-size: 19px;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .ou {
    font-size: 15px;
    font-weight: 500;
    color: var(--indigo-doux);
  }

  .etapes-barre {
    display: flex;
    align-items: center;
    gap: 5px;
    flex: 1 1 200px;
    max-width: 320px;
    min-height: 11px;
  }

  .etapes-barre a {
    flex: 1;
    height: 7px;
    border-radius: 2px;
    background: var(--brume);
    position: relative;
    transition: height 0.15s ease;
  }

  /* Zone de clic plus haute que le trait. */
  .etapes-barre a::after {
    content: '';
    position: absolute;
    inset: -10px 0;
  }

  .etapes-barre a.faite {
    background: var(--indigo);
  }

  .etapes-barre a.ici {
    background: var(--lavande);
    height: 11px;
  }

  .acquis-mini {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
  }

  .pips {
    display: flex;
    gap: 4px;
  }

  .pips i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid var(--lavande);
  }

  .pips i.plein {
    background: var(--menthe);
    border-color: var(--menthe);
  }

  @media (prefers-reduced-motion: no-preference) {
    .pips i.vient {
      animation: pastille 0.45s cubic-bezier(0.2, 0.8, 0.3, 1.5);
    }

    @keyframes pastille {
      from {
        transform: scale(0.2);
      }

      to {
        transform: none;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .etapes-barre a {
      transition: none;
    }
  }

  @media (max-width: 720px) {
    .barre-in {
      padding: 10px 20px;
      gap: 8px 16px;
    }

    /* Forme courte : « Partie 1, chapitre » est masqué à l'écran seulement
       (même motif que .vh), le reste de la position se voit toujours. */
    .ou-debut {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
      border: 0;
    }

    .etapes-barre {
      order: 3;
      flex-basis: 100%;
      max-width: none;
    }

    .acquis-mini > span:first-child {
      display: none;
    }
  }
</style>
