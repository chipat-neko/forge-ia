---
// Des commandes à taper, une par ligne, sans coloration ni invite : ce qu'on
// copie est exactement ce qu'il faut taper. La légende dit où les taper
// (« PowerShell » par défaut). Les commandes viennent d'un fichier vérifié
// (src/lib/partie-0/commandes.ts), jamais d'un texte tapé dans le chapitre.
// Son allure (légende, fond, zone qui défile) est celle de .bloc-terminal,
// dans src/styles/commandes.css, partagée avec SortieCommande.
//
//   <BlocCommande commandes={[INSTALLER_UV_WINDOWS, VERIFIER_UV]} />
//   <BlocCommande commandes={[INSTALLER_UV_LINUX_MAC]} ou="un terminal, sous Linux ou macOS" />
import { typographier } from '../../lib/typo';

interface Props {
  /** Les commandes, une par ligne. */
  commandes: string[];
  /** Où les taper, après « À taper dans » : « PowerShell » par défaut. */
  ou?: string;
}

const { commandes, ou = 'PowerShell' } = Astro.props;
if (commandes.length === 0) {
  throw new Error('BlocCommande sans commande : passe au moins une commande dans la prop commandes.');
}
---

<figure class="bloc-terminal bloc-commande">
  <figcaption>À taper dans {typographier(ou)}</figcaption>
  {/* Une zone qui défile doit prendre le focus pour se parcourir au clavier (WCAG 2.1.1). */}
  <div class="zone-defilable" role="region" aria-label={`Commandes à taper dans ${ou}, défilable`} tabindex="0">
    <pre><code>{commandes.join('\n')}</code></pre>
  </div>
</figure>

