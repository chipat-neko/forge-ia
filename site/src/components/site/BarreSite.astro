---
// Barre du haut des pages hors chapitre (accueil, parties, recherche, 404),
// collée en haut de l'écran et opaque, comme celle des chapitres : le nom du
// site, puis les liens vers le parcours et la recherche. Le slot reçoit ce
// qu'une page ajoute au milieu (la page de partie y met sa barre de chapitres).
interface Props {
  /** La page où l'on est, signalée par aria-current. */
  courant?: 'accueil' | 'recherche';
  /** Les liens de la navigation, dans l'ordre. */
  liens?: ('parcours' | 'annexes' | 'recherche')[];
}

const { courant, liens = ['parcours', 'recherche'] } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const accueil = `${base}/`;
const surAccueil = courant === 'accueil';
---

<header class="barre-site">
  <div class="barre-in">
    <a class="marque" href={accueil} aria-current={surAccueil ? 'page' : undefined}>La Forge IA</a>
    <slot />
    <nav class="nav" aria-label="Pages du site">
      {
        liens.map((lien) =>
          lien === 'parcours' ? (
            <a href={surAccueil ? '#parcours' : `${accueil}#parcours`}>Le parcours</a>
          ) : lien === 'annexes' ? (
            <a class="large" href={surAccueil ? '#annexes' : `${accueil}#annexes`}>
              Annexes
            </a>
          ) : (
            <a href={`${base}/recherche/`} aria-current={courant === 'recherche' ? 'page' : undefined}>
              <svg width="17" height="17" viewBox="0 0 17 17" aria-hidden="true">
                <circle cx="7" cy="7" r="5.2" fill="none" stroke="currentColor" stroke-width="2.4" />
                <path d="M11 11l4.6 4.6" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
              </svg>
              Rechercher
            </a>
          ),
        )
      }
    </nav>
  </div>
</header>

<style>
  /* Opaque : le texte ne doit pas se voir à travers quand on défile. */
  .barre-site {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--papier);
    border-bottom: 1px solid var(--brume);
  }

  .barre-in {
    max-width: 1180px;
    margin: 0 auto;
    padding: 12px 24px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 28px;
    font-family: var(--titres);
    line-height: 1.3;
  }

  .marque {
    font-weight: 800;
    font-size: 19px;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .nav {
    margin-left: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    font-size: 16px;
    font-weight: 600;
  }

  .nav a {
    text-decoration: none;
    padding: 4px 0;
  }

  .nav a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-decoration-color: var(--lavande);
  }

  .nav svg {
    vertical-align: -3px;
    margin-right: 7px;
  }

  @media (max-width: 720px) {
    .barre-in {
      padding: 10px 20px;
      gap: 6px 16px;
    }

    .nav {
      gap: 4px 16px;
      font-size: 15px;
    }

    .nav .large {
      display: none;
    }
  }
</style>
