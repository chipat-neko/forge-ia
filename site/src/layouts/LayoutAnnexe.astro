---
// Gabarit des pages d'annexe (maquette docs/maquettes/annexes.html) : la barre du site,
// avec au milieu la barre des annexes (la page courante soulignée), le titre de l'annexe
// avec son chapeau et sa note de marge, le contenu, puis les annexes voisines.
//
// Les annexes viennent de ANNEXES (parcours.ts), dans leur ordre : une annexe sans page
// (« Matériel ») est dite « à venir », sans lien. La grille (marge de gauche, colonne de
// lecture, marge de notes) est celle des chapitres et de la recherche.
//
// `indexer` met le contenu de l'annexe dans l'index de la recherche (Pagefind), comme un
// chapitre ; la barre et les voisines n'y entrent jamais.
import LayoutSite from './LayoutSite.astro';
import { ANNEXES } from '../lib/parcours';
import { typographier } from '../lib/typo';

interface Props {
  /** L'adresse de la page : celle de son annexe dans ANNEXES. */
  href: string;
  description: string;
  indexer?: boolean;
}

const { href, description, indexer = false } = Astro.props;
const rang = ANNEXES.findIndex((a) => a.href === href);
if (rang < 0) {
  throw new Error(`LayoutAnnexe : aucune annexe n’a l’adresse « ${href} » dans ANNEXES (src/lib/parcours.ts). Donne-lui son href.`);
}
const annexe = ANNEXES[rang];
const precedente = ANNEXES[rang - 1];
const suivante = ANNEXES[rang + 1];
const avecPage = ANNEXES.filter((a) => a.href !== undefined);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const titre = typographier(annexe.titrePage);
---

<LayoutSite titre={titre} description={typographier(description)} liens={['parcours', 'recherche']}>
  <nav slot="barre" class="annexes-nav" aria-label="Les annexes">
    <span class="ou">Annexes</span>
    {
      avecPage.map((a) => (
        <a href={a.href} aria-current={a.href === href ? 'page' : undefined}>
          {typographier(a.court)}
        </a>
      ))
    }
  </nav>

  <div class="annexe">
    <article data-annexe={annexe.court} aria-labelledby="titre-annexe" data-pagefind-body={indexer ? '' : undefined}>
      <div class="bloc titre-page">
        <div class="texte">
          <h1 id="titre-annexe">{titre}</h1>
          <slot name="ouverture" />
        </div>
        <slot name="note" />
      </div>
      <slot />
    </article>

    <footer class="bloc pied">
      <nav class="texte voisins" aria-label="Annexes voisines">
        {
          precedente?.href ? (
            <a href={precedente.href}>
              <span>Annexe précédente</span>
              <strong>{typographier(precedente.titrePage)}</strong>
            </a>
          ) : (
            <a href={`${base}/#annexes`}>
              <span>Retour</span>
              <strong>Toutes les annexes</strong>
            </a>
          )
        }
        {
          suivante &&
            (suivante.href ? (
              <a href={suivante.href}>
                <span>Annexe suivante</span>
                <strong>{typographier(suivante.titrePage)}</strong>
              </a>
            ) : (
              <p class="a-venir">
                <span>Annexe suivante, à venir</span>
                <strong>{typographier(suivante.titrePage)}</strong>
              </p>
            ))
        }
      </nav>
    </footer>
  </div>
</LayoutSite>

<style>
  /* La barre des annexes, au milieu de la barre du site. */
  .annexes-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 22px;
    font-family: var(--titres);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
  }

  .annexes-nav .ou {
    font-size: 15px;
    font-weight: 500;
    color: var(--indigo-doux);
    margin-right: -6px;
  }

  .annexes-nav a {
    text-decoration: none;
    padding: 4px 0;
  }

  .annexes-nav a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .annexes-nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-decoration-color: var(--lavande);
    text-underline-offset: 0.28em;
  }

  @media (max-width: 720px) {
    .annexes-nav {
      order: 3;
      flex-basis: 100%;
      gap: 2px 20px;
      font-size: 15px;
    }

    .annexes-nav .ou {
      display: none;
    }
  }
</style>

<style is:global>
  /* La grille des annexes : marge de gauche, colonne de lecture, marge de notes. Les pages
     d'annexe s'en servent aussi pour leur contenu (.annexe .bloc). */
  .annexe .bloc {
    display: grid;
    grid-template-columns: 56px minmax(0, 660px) 236px;
    column-gap: 44px;
    max-width: 1040px;
    margin-inline: auto;
    padding-inline: 24px;
    box-sizing: content-box;
  }

  .annexe .bloc > .texte {
    grid-column: 2;
    min-width: 0;
  }

  .annexe .bloc > .note {
    grid-column: 3;
    align-self: start;
  }

  .annexe .bloc > .large {
    grid-column: 2 / 4;
    min-width: 0;
  }

  .annexe .titre-page {
    padding-top: 64px;
  }

  .annexe h1 {
    text-wrap: balance;
    font-weight: 800;
    font-size: clamp(44px, 7vw, 84px);
    line-height: 0.96;
    letter-spacing: -0.03em;
    margin: 0 0 26px;
  }

  /* 29,5em, comme la colonne des chapitres : 80 caractères au plus par ligne. */
  .annexe .chapeau {
    font-size: 24px;
    line-height: 1.48;
    margin: 0 0 14px;
    max-width: 29.5em;
  }

  .annexe .programme {
    font-family: var(--titres);
    font-size: 17px;
    font-weight: 500;
    color: var(--indigo-doux);
    margin: 0;
    max-width: 32em;
  }

  .annexe .note {
    font-size: 16px;
    line-height: 1.5;
    color: var(--indigo-doux);
    padding-top: 8px;
  }

  .annexe .note p {
    margin: 0 0 0.8em;
  }

  /* Sous la colonne, sur tablette et téléphone, la note garde des lignes de 80 caractères au plus. */
  .annexe .note p,
  .annexe .note dl {
    max-width: 29.5em;
  }

  .annexe .note strong {
    font-family: var(--titres);
    font-weight: 600;
    color: var(--indigo);
  }

  .annexe .note a {
    color: var(--indigo);
  }

  .annexe .titre-page .note {
    padding-top: 112px;
  }

  .annexe .titre-page .note.haute {
    padding-top: 14px;
  }

  /* Le pied : les annexes voisines, comme les chapitres voisins. */
  .annexe .pied {
    padding-top: 88px;
  }

  .annexe .voisins {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    border-top: 2px solid var(--indigo);
    padding-top: 20px;
  }

  .annexe .voisins a,
  .annexe .voisins .a-venir {
    text-decoration: none;
    display: block;
    max-width: 48%;
    margin: 0;
  }

  .annexe .voisins > :last-child {
    text-align: right;
    margin-left: auto;
  }

  .annexe .voisins span {
    display: block;
    font-family: var(--titres);
    font-size: 15px;
    color: var(--indigo-doux);
  }

  .annexe .voisins strong {
    font-family: var(--titres);
    font-weight: 700;
    font-size: 24px;
    line-height: 1.2;
  }

  .annexe .voisins .a-venir strong {
    color: var(--indigo-doux);
    font-weight: 600;
  }

  .annexe .voisins a:hover strong {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  @media (max-width: 1140px) {
    .annexe .bloc {
      grid-template-columns: 56px minmax(0, 660px);
      max-width: 760px;
    }

    .annexe .bloc > .note {
      grid-column: 2;
      margin-top: 16px;
      padding: 0 0 0 1.2em;
      font-size: 15px;
    }

    .annexe .titre-page .note,
    .annexe .titre-page .note.haute {
      padding-top: 0;
    }

    .annexe .bloc > .large {
      grid-column: 2;
    }
  }

  @media (max-width: 720px) {
    .annexe .bloc {
      grid-template-columns: minmax(0, 1fr);
      padding-inline: 20px;
    }

    .annexe .bloc > .texte,
    .annexe .bloc > .note,
    .annexe .bloc > .large {
      grid-column: 1;
    }

    .annexe .titre-page {
      padding-top: 36px;
    }

    .annexe .chapeau {
      font-size: 20px;
    }

    .annexe .programme {
      font-size: 16px;
    }

    .annexe .voisins {
      flex-direction: column;
    }

    .annexe .voisins a,
    .annexe .voisins .a-venir {
      max-width: none;
    }

    .annexe .voisins > :last-child {
      text-align: left;
      margin-left: 0;
    }
  }
</style>
