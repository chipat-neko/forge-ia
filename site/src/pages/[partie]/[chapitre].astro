---
// Une page par chapitre écrit : src/content/chapitres/1-3.mdx devient
// /forge-ia/partie-1/1-3/. Les composants du gabarit sont fournis au MDX :
// un chapitre peut écrire <Etape>, <Pari>, <Verrou>, <EncadreLabo>,
// <CodeExplique> et <LiensProjet> sans les importer.
//
// Avec FORGE_ESSAIS=1 (npm run build:essais, lancé par Playwright), les
// brouillons src/brouillons/chapitres/<p>-<n>.mdx sont construits aussi, à leur
// adresse définitive, avec les mêmes composants, mais hors de l'index de la
// recherche (indexer={false}). Sans FORGE_ESSAIS, ils ne sont pas lus : le site
// publié n'en contient rien. Les pages de partie, le pied des chapitres et
// l'accueil ne lisent que la collection : un brouillon y reste « à venir ».
import type { MDXInstance } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import LayoutChapitre from '../../layouts/LayoutChapitre.astro';
import Etape from '../../components/gabarit/Etape.astro';
import Pari from '../../components/gabarit/Pari.astro';
import Verrou from '../../components/gabarit/Verrou.astro';
import EncadreLabo from '../../components/gabarit/EncadreLabo.astro';
import CodeExplique from '../../components/gabarit/CodeExplique.astro';
import LiensProjet from '../../components/gabarit/LiensProjet.astro';
import { schemaChapitre, type DonneesChapitre } from '../../content.config';
import { verifierBrouillons } from '../../lib/brouillons';

type Props =
  | { entree: CollectionEntry<'chapitres'> }
  | { donnees: DonneesChapitre; module: MDXInstance<Record<string, unknown>> };

export async function getStaticPaths() {
  const chapitres = await getCollection('chapitres');
  const parus = chapitres.map((entree) => {
    const [p, n] = entree.data.numero.split('.');
    if (entree.id !== `${p}-${n}`) {
      throw new Error(
        `Le fichier du chapitre ${entree.data.numero} doit s'appeler ${p}-${n}.mdx (trouvé : ${entree.id}).`,
      );
    }
    return { params: { partie: `partie-${p}`, chapitre: `${p}-${n}` }, props: { entree } };
  });
  if (import.meta.env.FORGE_ESSAIS !== '1') return parus;

  const modules = import.meta.glob<MDXInstance<Record<string, unknown>>>('../../brouillons/chapitres/*.mdx');
  const brouillons = await Promise.all(
    Object.entries(modules).map(async ([chemin, charger]) => {
      const module = await charger();
      const fichier = chemin.replace(/^.*\//, '');
      const verifie = schemaChapitre.safeParse(module.frontmatter);
      if (!verifie.success) {
        throw new Error(
          `Le frontmatter du brouillon src/brouillons/chapitres/${fichier} est invalide : corrige-le.\n${verifie.error.message}`,
        );
      }
      return { fichier, donnees: verifie.data, module };
    }),
  );
  verifierBrouillons(
    chapitres.map((entree) => entree.data.numero),
    brouillons.map(({ fichier, donnees }) => ({ numero: donnees.numero, fichier })),
  );
  return [
    ...parus,
    ...brouillons.map(({ donnees, module }) => {
      const [p, n] = donnees.numero.split('.');
      return { params: { partie: `partie-${p}`, chapitre: `${p}-${n}` }, props: { donnees, module } };
    }),
  ];
}

const props = Astro.props;
const composants = { Etape, Pari, Verrou, EncadreLabo, CodeExplique, LiensProjet };
const { donnees, Contenu, indexer } =
  'entree' in props
    ? { donnees: props.entree.data, Contenu: (await render(props.entree)).Content, indexer: true }
    : { donnees: props.donnees, Contenu: props.module.Content, indexer: false };
---

<LayoutChapitre {...donnees} indexer={indexer}>
  <Contenu components={composants} />
</LayoutChapitre>
